# NM INFOCOM server settings. Copy to `.env` and fill in.
#
# Where to put it (most secure first):
#   1. Hostinger: domains/<your-domain>/.env   (one folder ABOVE public_html, never web-accessible)
#   2. the project root next to index.php      (blocked from the web by .htaccess)
# Real environment variables with the same names take precedence.

# --- App ---------------------------------------------------------------
APP_URL=https://www.nminfocom.in        # public URL, used in emails (no trailing slash)
APP_DEBUG=0                             # 1 shows PHP errors; never enable in production

# --- Database ----------------------------------------------------------
DB_HOST=localhost
DB_NAME=u544400122_nm
DB_USER=u544400122_nm
DB_PASS=


# --- CRM sessions --------------------------------------------------------
# 32+ random characters. Generate with:  php -r "echo bin2hex(random_bytes(32));"
# Changing it signs everyone out.
CRM_JWT_SECRET=

# --- Outgoing email (login credentials for new users) ----------------------
# Hostinger: smtp.hostinger.com, 465 + ssl (or 587 + tls), with a mailbox created in hPanel → Emails.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl                         # ssl, tls or empty for none
SMTP_USER=mcnikte@nminfocom.com
SMTP_PASS=
MAIL_FROM=mcnikte@nminfocom.com
MAIL_FROM_NAME="NM INFOCOM"

# --- Misc ------------------------------------------------------------------
NM_IP_SALT=                             # random string; salts visitor-IP hashes in the form rate-limit log
